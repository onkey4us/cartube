<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg"
    android:orientation="horizontal">

    <!-- Left Car Navigation Rail (Large 56dp+ touch targets) -->
    <ScrollView
        android:layout_width="176dp"
        android:layout_height="match_parent"
        android:background="@color/car_surface"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="14dp"
                android:text="CarTube"
                android:textColor="@color/car_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navHome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_home"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navMusic"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_music"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navSubs"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_subscriptions"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navHistory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_history"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/navSearch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_search"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/car_divider" />

            <LinearLayout
                android:id="@+id/navAccount"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvAccountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nav_account"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/navSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_nav_item"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:text="@string/nav_settings"
                android:textColor="@color/car_text_secondary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- Main Content Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header + Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="@color/car_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/searchBarContainer"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/car_text_primary"
                    android:textColorHint="@color/car_text_secondary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnSearchClear"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:backgroundTint="@color/car_surface_elevated"
                    android:text="✕"
                    android:textColor="@color/car_text_primary" />

                <Button
                    android:id="@+id/btnSearchSubmit"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/car_accent"
                    android:text="Tìm"
                    android:textColor="@color/car_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Feed Grid Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVideos"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingHorizontal="14dp"
                    android:paddingBottom="12dp" />

                <Button
                    android:id="@+id/btnLoadMore"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="10dp"
                    android:backgroundTint="@color/car_surface_elevated"
                    android:text="@string/load_more"
                    android:textColor="@color/car_text_primary"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="28dp"
                android:textColor="@color/car_text_secondary"
                android:textSize="17sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/car_accent"
                    android:paddingHorizontal="28dp"
                    android:text="@string/retry"
                    android:textColor="@color/car_text_primary" />
            </LinearLayout>
        </FrameLayout>

        <!-- Persistent Mini-Player Bar -->
        <LinearLayout
            android:id="@+id/miniPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@color/car_surface_elevated"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivMiniThumb"
                android:layout_width="96dp"
                android:layout_height="54dp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_thumb_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMiniAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnMiniPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_circle_btn"
                android:contentDescription="Bài trước"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_player_circle_btn"
                android:contentDescription="Phát hoặc tạm dừng"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btnMiniNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_circle_btn"
                android:contentDescription="Bài tiếp"
                android:src="@drawable/ic_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
