<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg"
    android:orientation="horizontal">

    <!-- Compact Left Icon Rail (104dp, visible in Fullscreen & Large Split) -->
    <LinearLayout
        android:id="@+id/leftNavRail"
        android:layout_width="104dp"
        android:layout_height="match_parent"
        android:background="@color/car_surface"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/nav_home"
                android:duplicateParentState="true"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_home"
                android:textColor="@color/nav_item_tint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMusic"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/nav_music"
                android:duplicateParentState="true"
                android:src="@drawable/ic_music"
                app:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_music"
                android:textColor="@color/nav_item_tint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSubs"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/nav_subscriptions"
                android:duplicateParentState="true"
                android:src="@drawable/ic_subscriptions"
                app:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_subscriptions"
                android:textColor="@color/nav_item_tint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/nav_history"
                android:duplicateParentState="true"
                android:src="@drawable/ic_history"
                app:tint="@color/nav_item_tint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/nav_history"
                android:textColor="@color/nav_item_tint"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/navAccount"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_item"
            android:clickable="true"
            android:contentDescription="@string/nav_account"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAccountIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_account"
                app:tint="@color/car_text_primary" />

            <View
                android:id="@+id/viewAccountSignedDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_circle_red"
                android:visibility="gone" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_nav_item"
            android:contentDescription="@string/nav_settings"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            app:tint="@color/car_text_primary" />
    </LinearLayout>

    <!-- Main Content Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Compact 5-Icon Top Bar (Visible ONLY in Narrow ~360dp Mode) -->
        <LinearLayout
            android:id="@+id/compactTopBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/compactHome"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="@string/nav_home"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_item_tint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/compactMusic"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="@string/nav_music"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music"
                app:tint="@color/nav_item_tint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/compactSearch"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="@string/nav_search"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@color/nav_item_tint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/compactVoice"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="Tìm bằng giọng nói"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/car_text_primary" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/compactSettings"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="@string/nav_settings"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/car_text_primary" />
        </LinearLayout>

        <!-- Top Search Bar + Fixed Red Mic Button -->
        <LinearLayout
            android:id="@+id/topSearchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/searchPillContainer"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/nav_search"
                    android:src="@drawable/ic_search"
                    app:tint="@color/car_text_hint" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/car_text_primary"
                    android:textColorHint="@color/car_text_hint"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/btnSearchClear"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="Xóa tìm kiếm"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/car_text_secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="Tìm bằng giọng nói"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mic"
                app:tint="@color/car_text_primary" />
        </LinearLayout>

        <!-- Category Chips Row -->
        <HorizontalScrollView
            android:id="@+id/categoryChipScroll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/categoryChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Feed Grid Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/car_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:textColor="@color/car_text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/errorContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/car_accent"
                    android:paddingHorizontal="28dp"
                    android:text="@string/retry"
                    android:textColor="@color/car_text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Mini Player Bar -->
        <LinearLayout
            android:id="@+id/miniPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/car_surface"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/car_divider" />

            <LinearLayout
                android:id="@+id/miniPlayerRow"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp">

                <FrameLayout
                    android:id="@+id/miniThumbFrame"
                    android:layout_width="128dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_rounded_thumb"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <ImageView
                        android:id="@+id/ivMiniThumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Ảnh thu nhỏ"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_thumb_placeholder" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/miniInfoContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMiniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/car_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMiniAuthor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/car_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miniSeekContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_weight="1.2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvMiniCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/car_text_secondary"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/miniSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_weight="1"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:progressDrawable="@drawable/bg_seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/bg_seekbar_thumb" />

                    <TextView
                        android:id="@+id/tvMiniTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="@color/car_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnMiniPrev"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="Bài trước"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_prev"
                    app:tint="@color/car_text_primary" />

                <ImageButton
                    android:id="@+id/btnMiniPlayPause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="Phát hoặc tạm dừng"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/car_bg" />

                <ImageButton
                    android:id="@+id/btnMiniNext"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_transparent"
                    android:contentDescription="Bài tiếp"
                    android:padding="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_next"
                    app:tint="@color/car_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
