<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_resume_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvResumeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/resume_title"
        android:textColor="@color/car_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <FrameLayout
            android:id="@+id/thumbFrame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_rounded_thumb"
            android:clipToOutline="true"
            android:outlineProvider="background"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh thu nhỏ bài nghe tiếp"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_thumb_placeholder" />

            <ProgressBar
                android:id="@+id/progressResume"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_gravity="bottom"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/bg_thin_progress" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textColor="@color/car_text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/car_text_secondary"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnResumePlay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_red"
            android:contentDescription="Nghe tiếp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="@color/car_text_primary" />
    </LinearLayout>
</LinearLayout>
