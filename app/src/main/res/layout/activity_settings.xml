<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_player_circle_btn"
                android:contentDescription="Quay lại"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cài đặt tối ưu đầu xe"
                android:textColor="@color/car_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Max Quality Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Độ phân giải video tối đa"
                android:textColor="@color/car_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb480p"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="24dp"
                    android:text="480p (Tiết kiệm 4G)"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb720p"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="24dp"
                    android:text="720p (Nhẹ nhất - Khuyên dùng)"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rb1080p"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="1080p (Full HD)"
                    android:textColor="@color/car_text_primary"
                    android:textSize="16sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- Performance & AdBlock Switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swBlockAv1"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Chặn codec AV1 (ép H.264/VP9 giải mã phần cứng i.MX8Q)"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swBgAudioOnly"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Tự tắt video (chỉ phát tiếng) khi thu nhỏ sang Vietmap / Google Maps"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swSponsorBlock"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SponsorBlock — tự động bỏ qua đoạn quảng cáo tài trợ trong video"
                android:textColor="@color/car_text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="4dp"
            android:padding="16dp"
            android:textColor="@color/car_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
